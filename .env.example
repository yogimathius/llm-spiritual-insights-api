# Perspective Loom Environment Configuration
# Copy this file to .env for local development. Never commit real secrets.

# Django Security & Runtime
DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (defaults to SQLite db.sqlite3 if unset)
# For PostgreSQL: postgres://user:password@localhost:5432/perspective_loom
DATABASE_URL=

# Authentication & API Access
# Optional API key required for mutating/private endpoints when REQUIRE_AUTH=True
PERSPECTIVE_LOOM_API_KEY=
REQUIRE_AUTH=False
DATA_RETENTION_DAYS=90

# Model Providers
# Provider options: fake, github_models, openai, ollama
DEFAULT_MODEL_PROVIDER=fake
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://models.inference.ai.azure.com
DEFAULT_HOSTED_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2
PROVIDER_TIMEOUT_SECONDS=30.0
PROVIDER_MAX_RETRIES=2
